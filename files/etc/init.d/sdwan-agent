#!/bin/sh /etc/rc.common
# OpenWrt procd unit for sdwan-agent — single instance
START=96
STOP=10
USE_PROCD=1
PROG=/usr/sbin/sdwan-agent

start_service() {
	if [ ! -f /etc/sdwan-agent/config ]; then
		echo "sdwan-agent: missing /etc/sdwan-agent/config" >&2
		return 1
	fi
	procd_open_instance
	procd_set_param command /bin/sh "$PROG"
	procd_set_param file /etc/sdwan-agent/config
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/sdwan-agent.pid
	procd_close_instance
}

stop_service() {
	# Agent holds /var/run/sdwan-agent.lock; clear after procd stops instance
	rm -rf /var/run/sdwan-agent.lock
}

reload_service() {
	stop
	start
}
