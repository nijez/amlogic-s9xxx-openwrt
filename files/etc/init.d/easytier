#!/bin/sh /etc/rc.common
# OpenWrt procd。安装为 /etc/init.d/easytier
# 配置里还有尖括号时不要 start。

START=95
STOP=10
USE_PROCD=1

start_service() {
	if [ ! -f /etc/easytier/easytier.toml ]; then
		echo "easytier: 缺少 /etc/easytier/easytier.toml" >&2
		return 1
	fi
	if grep -v '^[[:space:]]*#' /etc/easytier/easytier.toml | grep -q '<'; then
		echo "easytier: 配置仍含占位符，拒绝启动" >&2
		return 1
	fi
	procd_open_instance
	# v2.6.4 的 toml 没有 rpc_portal 字段。用启动参数绑到本机。
	procd_set_param command /usr/bin/easytier-core -c /etc/easytier/easytier.toml --rpc-portal 127.0.0.1:15888
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
